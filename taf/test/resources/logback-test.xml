<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console Appender with MDC support for parallel tests -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%cyan(%d{HH:mm:ss.SSS}) %gray([%thread]) %magenta([%X{testId}]) %highlight(%-5level) %blue(%logger{20}) - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Console Appender for Test Results with test context -->
    <appender name="TEST_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%cyan(%d{HH:mm:ss.SSS}) %magenta([%X{testName}]) %highlight(%-5level) - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- File Appender for Test Logs with MDC context -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/test-execution.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/test-execution.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{testName}] [%X{testId}] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- API Request/Response Appender for debugging -->
    <appender name="API_LOG" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/api-requests.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/api-requests.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{testName}] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Logger for E2E Test Classes - Simplified logging -->
    <logger name="test" level="INFO" additivity="false">
        <appender-ref ref="TEST_CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <!-- Logger for Framework Components with proper levels -->
    <logger name="com.bookstore.taf" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <!-- Logger for API Requests - Debug level for detailed tracking -->
    <logger name="client.RestClient" level="DEBUG" additivity="false">
        <appender-ref ref="API_LOG"/>
        <appender-ref ref="FILE"/>
    </logger>

    <!-- Logger for RestAssured - Info level to avoid spam -->
    <logger name="io.restassured" level="INFO" additivity="false">
        <appender-ref ref="API_LOG"/>
    </logger>

    <!-- Logger for TestContainers -->
    <logger name="org.testcontainers" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <!-- Root Logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>